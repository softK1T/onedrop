# ---------------------------------------------------------------------------
# OneDrop example environment. Copy to .env and adjust. Never commit real keys.
# ---------------------------------------------------------------------------

# Application
APP_ENV=development                  # development | staging | production
APP_NAME=OneDrop
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000
PUBLIC_API_URL=http://localhost:8000
PUBLIC_WEBAPP_URL=http://localhost:5173
SECRET_KEY=dev-only-change-me-32-chars-minimum
CORS_ALLOW_ORIGINS=http://localhost:5173,https://web.telegram.org
TRUSTED_HOSTS=localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=60

# Auth
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
INIT_DATA_MAX_AGE_SECONDS=86400
DEV_LOGIN_ENABLED=true               # forced off when APP_ENV=production

# Database
POSTGRES_USER=onedrop
POSTGRES_PASSWORD=onedrop
POSTGRES_DB=onedrop
DATABASE_URL=postgresql+asyncpg://onedrop:onedrop@postgres:5432/onedrop

# Redis / queue
REDIS_URL=redis://redis:6379/0

# Object storage (MinIO in development)
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=onedrop
S3_SECRET_KEY=onedrop-dev-secret
S3_BUCKET=onedrop-media
S3_REGION=us-east-1
MEDIA_RETENTION_DAYS=30
MAX_UPLOAD_BYTES=10485760

# Telegram
TELEGRAM_BOT_TOKEN=                  # empty -> bot runs in disabled/demo state
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
BOT_MODE=polling                     # polling | webhook | disabled

# AI providers
AI_PROVIDER_MODE=fake                # fake | real
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1
VISION_MODEL=openai/gpt-4o-mini
AI_REQUEST_TIMEOUT_SECONDS=60
AI_MIN_CONFIDENCE=0.55

# Plans and limits
FREE_ONBOARDING_BONUS=15
FREE_DAILY_AI_LIMIT=3
PRO_MONTHLY_AI_LIMIT=1000
PRO_PRICE_STARS=250
PRO_PERIOD_DAYS=30

# Defaults
DEFAULT_TIMEZONE=Europe/Warsaw
DEFAULT_LOCALE=en
DEFAULT_BASE_CURRENCY=PLN

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_DEV_LOGIN=true
